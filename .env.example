# Cle API Anthropic - https://console.anthropic.com/settings/keys
# Renseigne-la dans .env, jamais ici.
ANTHROPIC_API_KEY=

# Modele utilise par le coach (brief, validation, indices, notation)
COACH_MODEL=claude-sonnet-5

# Seuil de validation d'un projet, sur 20
PASS_THRESHOLD=14.0

# Malus applique a la note finale par indice consomme (palier 1, 2, 3)
HINT_PENALTIES=0.5,1.0,2.0

# Remote GitHub du monorepo d'exercices (laisser vide pour commit local seulement)
GIT_REMOTE=
GIT_BRANCH=main
